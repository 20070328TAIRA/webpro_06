<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table border="1">
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>名前</td><td><%= data.name %></td></tr>
    <tr><td>誕生日</td><td><%= data.birthday %></td></tr>
    <tr><td>身長（cm）</td><td><%= data.height %></td></tr>
    <tr><td>担当声優</td><td><%= data.voice %></td></tr>
  </table>
  <br>
  <a href="/char">一覧に戻る</a>
</body>
</html>