<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <table border="1">
    <tr><th>項目</th><th>データ</th></tr>
    <tr><td>ID</td><td><%= data.id %></td></tr>
    <tr><td>タイトル</td><td><%= data.name %></td></tr>
    <tr><td>日本公開日</td><td><%= data.birthday %></td></tr>
    <tr><td>上映時間（分）</td><td><%= data.time %></td></tr>
    <tr><td>次作・続編</td><td><%= data.next %></td></tr>
  </table>
  <br>
  <a href="/movie">一覧に戻る</a>
</body>
</html>