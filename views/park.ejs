<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>世界のディズニーリゾート一覧</title>
</head>
<body>
  <h2>世界のディズニーリゾート一覧</h2>
  <p><a href="/park_add_page">＋ 新しいパークを追加する</a></p>

  <table border="1">
    <tr><th>ID</th><th>名前</th><th>操作</th></tr>
      <% let number = 0 %>
      <% for( let row of data ) { %>
        <tr>
          <td><%= row.id %></td>
          <td><a href="/park/<%= number %>"><%= row.name %></a></td>
          <td>
            <a href="/park_edit_page/<%= number %>">編集</a>
            <a href="/park_del/<%= number %>" onclick="return confirm('本当に削除しますか？')">削除</a>
          </td>
        </tr>
        <% number += 1 %>
      <% } %>
  </table>
</body>
</html>