<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>映画を編集する</title>
</head>
<body>
    <h2>映画情報の編集</h2>
    <form action="/movie_update">
        <input type="hidden" name="index" value="<%= index %>">
        <label>ID: <input type="number" name="id" value="<%= data.id %>" required></label><br>
        <label>タイトル: <input type="text" name="name" value="<%= data.name %>" required></label><br>
        <label>日本公開日: <input type="text" name="birthday" value="<%= data.birthday %>"></label><br>
        <label>上映時間（分）: <input type="text" name="time" value="<%= data.time %>"></label><br>
        <label>次作・続編: <input type="text" name="next" value="<%= data.next %>"></label><br>
        <input type="submit" value="更新">
    </form>
    <br>
    <a href="/movie">キャンセル</a>
</body>
</html>