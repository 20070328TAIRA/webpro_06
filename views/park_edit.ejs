<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>パークを編集する</title>
</head>
<body>
    <h2>パーク情報の編集</h2>
    <form action="/park_update">
        <input type="hidden" name="index" value="<%= index %>">
        <label>ID: <input type="number" name="id" value="<%= data.id %>" required></label><br>
        <label>名前: <input type="text" name="name" value="<%= data.name %>" required></label><br>
        <label>開園日: <input type="text" name="birthday" value="<%= data.birthday %>"></label><br>
        <label>国: <input type="text" name="kuni" value="<%= data.kuni %>"></label><br>
        <label>特徴: <input type="text" name="etc" value="<%= data.etc %>"></label><br>
        <input type="submit" value="更新">
    </form>
    <br>
    <a href="/park">キャンセル</a>
</body>
</html>